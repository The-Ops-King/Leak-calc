# Sub-account Private Integration token. Never commit the real value.
GHL_PRIVATE_TOKEN=pit-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Sub-account (location) ID.
GHL_LOCATION_ID=xxxxxxxxxxxxxxxxxxxx

# Optional. HighLevel currently documents both "2021-07-28" and "v3" for the
# Version header. The function defaults to 2021-07-28 and retries once with v3
# if the API rejects the version, so you normally do not need to set this.
# GHL_API_VERSION=2021-07-28
