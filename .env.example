# --- HighLevel (required) ---
# Sub-account Private Integration token. Never commit the real value.
GHL_PRIVATE_TOKEN=pit-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Sub-account (location) ID.
GHL_LOCATION_ID=xxxxxxxxxxxxxxxxxxxx

# Optional. HighLevel documents both "2021-07-28" and "v3" for the Version
# header. The function sends 2021-07-28 and retries once with v3 if the API
# rejects it, so you normally do not need this.
# GHL_API_VERSION=2021-07-28

# --- Breakdown email (optional) ---
# Unset and the contact is still created; the confirmation screen just says you
# will be in touch instead of claiming an email went out.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
MAIL_FROM=Tyler <tyler@jtylerray.com>
# MAIL_REPLY_TO=tyler@jtylerray.com

# --- Google Sheet (optional) ---
# Two credential types are accepted. Set one. If both are set the service
# account wins, because an unattended function should prefer the credential
# that cannot expire. GOOGLE_AUTH_MODE=oauth|service_account forces one.

# The sheet is already created with its header row:
# https://docs.google.com/spreadsheets/d/1SdRyBHGme5OMFkWJNwh_U5kvzFbvB_A0gmI6qKnYZgc/edit
GOOGLE_SHEET_ID=1SdRyBHGme5OMFkWJNwh_U5kvzFbvB_A0gmI6qKnYZgc

# Optional. Without a tab name the append goes to the first sheet, which is
# what you want unless you add more tabs later.
# GOOGLE_SHEET_RANGE='Submissions'!A:Q

# Option A, service account. A robot identity with its own empty Drive; share
# the sheet with this address as an Editor. Never expires. Best for servers.
GOOGLE_SERVICE_ACCOUNT_EMAIL=automation@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Option B, OAuth acting as you. Reaches Gmail and Calendar as well, at the
# cost of a token that dies on a password change, on revoking app access,
# after six months idle, and after 7 days if the consent screen is in Testing.
# Mint the refresh token with: npm run google:auth
# GOOGLE_OAUTH_CLIENT_ID=....apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=...
# GOOGLE_OAUTH_REFRESH_TOKEN=1//0...
