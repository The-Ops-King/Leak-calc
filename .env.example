# --- HighLevel (required) ---
# Sub-account Private Integration token. Never commit the real value.
GHL_PRIVATE_TOKEN=pit-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Sub-account (location) ID.
GHL_LOCATION_ID=xxxxxxxxxxxxxxxxxxxx

# Optional. HighLevel documents both "2021-07-28" and "v3" for the Version
# header. The function sends 2021-07-28 and retries once with v3 if the API
# rejects it, so you normally do not need this.
# GHL_API_VERSION=2021-07-28

# --- Breakdown email (optional) ---
# Unset and the contact is still created; the confirmation screen just says you
# will be in touch instead of claiming an email went out.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
MAIL_FROM=Tyler <tyler@jtylerray.com>
# MAIL_REPLY_TO=tyler@jtylerray.com

# --- Google Sheet (optional) ---
# Service account with the Sheets API enabled. Share the sheet with the service
# account address as an Editor, or every append returns 403.
# GOOGLE_PRIVATE_KEY is the private_key field from the downloaded JSON key,
# newlines and all. Vercel stores it on one line with \n escapes; the function
# handles both shapes.
GOOGLE_SERVICE_ACCOUNT_EMAIL=leak-calc@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz0123456789
# GOOGLE_SHEET_RANGE=Submissions!A:Q
